<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <AssemblyName>VL.IO.AbletonLink</AssemblyName>
    <RootNamespace>VL.IO</RootNamespace>
    <OutputPath>..\lib</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>bj-rn</Authors>
    <Company>Studio JHH</Company>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AbletonLinkDLL\**" />
    <EmbeddedResource Remove="AbletonLinkDLL\**" />
    <None Remove="AbletonLinkDLL\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AbletonLinkDLL\AbletonLinkDLL.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VL.Audio" Version="1.9.17" />
  </ItemGroup>

</Project>
