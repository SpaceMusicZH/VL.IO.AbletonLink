<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VL.IO.AbletonLink</id>
    <version>2.0.0</version>
    <title>VL.IO.AbletonLink</title>
    <authors>bj-rn</authors>
    <owners>Studio JHH</owners>
    <license type="expression">CC0-1.0</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <readme>README.md</readme>
    <projectUrl>https://github.com/SpaceMusicZH/VL.IO.AbletonLink</projectUrl>
    <summary>A VL wrapper for Ableton Link 4.0 (with Link Audio)</summary>
    <description>Synchronize vvvv to other Ableton Link enabled applications and devices, and stream audio peer-to-peer using Link Audio (Live 12.4+). Built on Ableton Link 4.0.</description>
    <copyright>Copyright © 2026 Studio JHH</copyright>
    <tags>VL, vvvv, sync, synchronize, Ableton, Link, LinkAudio, audio, network</tags>
    <dependencies>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="VL.Audio" version="1.9.17" />
      </group>
    </dependencies>
  </metadata>
   <files>
    <file src="..\lib\net8.0-windows\VL.IO.AbletonLink.dll" target="lib\net8.0-windows" />
    <file src="..\lib\net8.0-windows\AbletonLinkDLL.dll" target="lib\net8.0-windows" />
    <file src="..\*.vl"/>
    <file src="..\help\*.vl" target="help"/>
    <file src="..\README.md" />
    <file src="..\LICENSE" />
  </files>
</package>
